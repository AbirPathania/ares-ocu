/* ARES OCU. Palette and type rationale live in ocu/ui/theme.py.
   Colour is reserved for status: blue is own forces, amber is caution,
   red is threat. Chrome is greyscale so the eye never has to work out
   which colour is information. Corners are square and rules are hairlines. */


* {
    color: #C6D0DA;
    font-family: "Helvetica Neue", sans-serif;
    font-size: 12px;
}

QMainWindow, QWidget {
    background-color: #0A0E12;
}

QWidget#topBar {
    background-color: #0C1116;
    border-bottom: 1px solid #3A4756;
    min-height: 38px;
}

QLabel#missionClock {
    font-size: 18px;
    font-weight: bold;
    color: #4A9FD4;
}

QLabel#provenanceChip {
    font-family: "DIN Condensed"; font-size: 12px; letter-spacing: 1px;
    font-weight: bold;
    color: #C9952F;
    background-color: #1F1C14;
    border: 1px solid #4A4128;
    padding: 4px 8px;
}

QLabel#phaseLabel {
    font-family: "DIN Condensed"; font-size: 16px; letter-spacing: 1px;
    font-weight: bold;
    color: #4A9FD4;
    padding-left: 6px;
}

QComboBox#modeCombo {
    font-family: "DIN Condensed";
    font-size: 13px;
    font-weight: bold;
    max-width: 210px;
}

QLabel#statusChip {
    font-family: "DIN Condensed"; font-size: 13px; letter-spacing: 1px;
    font-weight: bold;
    background-color: #12181c;
    border: 1px solid #283340;
    padding: 4px 8px;
}

QLabel#panelTitle {
    font-family: "DIN Condensed"; font-size: 16px; letter-spacing: 1px;
    font-weight: bold;
    color: #E8EDF2;
    padding-bottom: 2px;
}

QLabel#sectionLabel {
    font-family: "DIN Condensed"; font-size: 12px; letter-spacing: 1px;
    font-weight: bold;
    color: #7B8794;
    padding: 5px 2px 3px 2px;
    border-top: 1px solid #283340;
}

QLabel#manualHint {
    color: #D9B257;
    font-family: "DIN Condensed";
    font-size: 12px;
    letter-spacing: 1px;
    font-weight: bold;
    background-color: #1F1C14;
    border: 1px solid #4A4128;
    padding: 5px;
}

QPushButton#returnButton {
    background-color: #20201A;
    border-color: #4A4128;
    color: #D9B257;
}

QLabel#mutedNote {
    color: #7B8794;
    font-size: 9px;
}

QLabel#recordingIndicator {
    color: #C04438;
    font-weight: bold;
    font-size: 10px;
}

QPushButton {
    font-family: "DIN Condensed";
    letter-spacing: 1px;
    background-color: #182029;
    border: 1px solid #3A4756;
    padding: 7px 14px;
    font-size: 13px;
    font-weight: bold;
    color: #C6D0DA;
}

QPushButton:hover {
    background-color: #1E2832;
    border-color: #48566A;
}

QPushButton:pressed {
    background-color: #243040;
}

QPushButton:disabled {
    color: #4F5B68;
    background-color: #121820;
    border-color: #283340;
}

QPushButton#playButton {
    background-color: #17344A;
    border-color: #2E5F80;
    color: #8FC9E8;
    min-width: 76px;
}

QPushButton#playButton:hover {
    background-color: #1D4463;
}

QPushButton#launchAircraftButton {
    background-color: #17344A;
    border-color: #2E5F80;
    color: #8FC9E8;
}

QPushButton#launchAircraftButton:hover {
    background-color: #1D4463;
}

QPushButton#cutLinkButton {
    background-color: #2E1A18;
    border-color: #5A2F2A;
    color: #D4675A;
}

QPushButton#cutLinkButton:hover {
    background-color: #4a2626;
}

QWidget#alertBanner {
    background-color: #1A1315;
    border: 1px solid #C04438;
}

QLabel#alertTitle {
    color: #D4675A;
    font-weight: bold;
    font-family: "DIN Condensed"; font-size: 15px; letter-spacing: 1px;
}

QLabel#alertMessage {
    color: #C6D0DA;
    font-size: 11px;
}

QLabel#alertCountdown {
    color: #D4675A;
    font-size: 20px;
    font-weight: bold;
}

QPushButton#confirmButton {
    background-color: #4A211C;
    border-color: #C04438;
    color: #E8EDF2;
}

QPushButton#confirmButton:hover {
    background-color: #5A2F2A;
}

QListWidget#eventLogList {
    background-color: #080B0F;
    border: 1px solid #283340;
    font-size: 10px;
    color: #7B8794;
}

QDoubleSpinBox, QComboBox {
    background-color: #0C1116;
    border: 1px solid #3A4756;
    padding: 5px 8px;
    color: #C6D0DA;
    font-size: 11px;
    min-height: 20px;
}

QDoubleSpinBox:focus, QComboBox:focus {
    border-color: #4A9FD4;
}

QDoubleSpinBox:hover, QComboBox:hover {
    border-color: #48566A;
}

/* The popup is a separate top-level widget and inherits none of the styling
   above unless it is named explicitly, which is why it rendered as a cramped
   native list that clipped its longest entry. */
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 20px;
    border-left: 1px solid #3A4756;
}

QComboBox::down-arrow {
    image: none;
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #7B8794;
}

QComboBox::down-arrow:disabled {
    border-top-color: #4F5B68;
}

QComboBox QAbstractItemView {
    background-color: #12181c;
    border: 1px solid #48566A;
    color: #C6D0DA;
    selection-background-color: #1D4463;
    selection-color: #E8EDF2;
    outline: none;
    padding: 3px;
}

QComboBox QAbstractItemView::item {
    min-height: 24px;
    padding: 4px 10px;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #1D4463;
    color: #E8EDF2;
}

QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    width: 18px;
    background-color: #182029;
    border-left: 1px solid #3A4756;
}

QDoubleSpinBox::up-button {
    subcontrol-position: top right;
}

QDoubleSpinBox::down-button {
    subcontrol-position: bottom right;
}

QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #243040;
}

QDoubleSpinBox::up-arrow, QDoubleSpinBox::down-arrow {
    width: 7px;
    height: 7px;
    background-color: #7B8794;
}

QDoubleSpinBox::up-arrow {
}

QDoubleSpinBox::down-arrow {
}

QDoubleSpinBox::up-arrow:disabled, QDoubleSpinBox::down-arrow:disabled {
    background-color: #3a4149;
}

QCheckBox {
    color: #C6D0DA;
    font-family: "DIN Condensed";
    font-size: 13px;
    letter-spacing: 1px;
    font-weight: bold;
    spacing: 6px;
}

QCheckBox:disabled {
    color: #4F5B68;
}

QCheckBox::indicator {
    width: 13px;
    height: 13px;
    border: 1px solid #48566A;
    background-color: #0C1116;
}

QCheckBox::indicator:checked {
    background-color: #4A9FD4;
    border-color: #4A9FD4;
}

QCheckBox::indicator:hover {
    border-color: #4A9FD4;
}

QCheckBox::indicator:disabled {
    border-color: #283340;
    background-color: #121820;
}

QLabel#stageLabel {
    font-weight: bold;
    font-family: "DIN Condensed"; font-size: 17px; letter-spacing: 1px;
    color: #C9952F;
}

QSplitter::handle {
    background-color: #283340;
}

QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollBar:vertical {
    background: #0A0E12;
    width: 8px;
}

QScrollBar::handle:vertical {
    background: #3A4756;
    min-height: 20px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QPushButton#cardConfirm, QPushButton#cardReject {
    font-family: "DIN Condensed";
    font-size: 11px;
    letter-spacing: 1px;
    padding: 1px 4px;
    min-height: 0;
}

QPushButton#cardConfirm {
    background-color: #4A211C;
    border: 1px solid #C04438;
    color: #E8EDF2;
}

QPushButton#cardReject {
    background-color: #182029;
    border: 1px solid #3A4756;
    color: #7B8794;
}

QLabel#paceValue {
    font-family: "DIN Condensed"; font-size: 14px; letter-spacing: 1px;
    font-weight: bold; color: #8FC9E8;
    background-color: #12181c; border: 1px solid #283340; padding: 4px 0px;
}

QSlider#paceSlider { min-height: 22px; }
QSlider#paceSlider::groove:horizontal {
    height: 4px; background: #283340; border-radius: 2px;
}
QSlider#paceSlider::sub-page:horizontal {
    background: #2E5F80; border-radius: 2px;
}
QSlider#paceSlider::handle:horizontal {
    width: 12px; height: 12px; margin: -5px 0;
    background: #8FC9E8; border: 1px solid #17344A; border-radius: 7px;
}
QSlider#paceSlider::handle:horizontal:hover { background: #BFE3F5; }

QPushButton#destinationButton {
    background-color: #2A2314; border-color: #6B5A2A; color: #E8B04A;
}
QPushButton#destinationButton:hover { background-color: #3A3019; }
QPushButton#destinationButton[state="placing"] {
    background-color: #4A3B14; border-color: #E8B04A; color: #FFD98A;
}
QPushButton#destinationButton[state="set"] {
    background-color: #1A1F24; border-color: #3A4652; color: #B8C4CF;
}
